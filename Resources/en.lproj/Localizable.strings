/* English text for identifier-style keys. Every other key is its own English text. */

"settings.menuSpace.footer" = "Optional. On displays without a notch, lets long titles use the free space up to the active app's menus instead of a fixed width. Not needed on a MacBook screen. Requires Accessibility access, used only to read where the app menus end.";
"settings.position.row" = "macOS puts new items at the far left of the menu bar and hides them first when it gets crowded. Hold ⌘ and drag the Calenbar item next to the clock once; it stays there across relaunches and updates.";
"settings.privacy.footer" = "The menu bar shows “Meeting • in 12m” instead of the title, so a shared screen or a recording doesn't reveal it. The panel is unchanged. Also in the panel's ••• menu and the item's right-click menu.";
"settings.shortcut.footer" = "⌃⌘J by default; record another one, or remove it with the ×. It works in any app and joins the meeting shown in the menu bar, or the next one with a link.";
"settings.alert.footer" = "The card sits in the top-right corner, over every desktop and full-screen app, and stays until you join, snooze or close it. Full screen blurs everything and can't be missed. Both go away on their own when the meeting ends.";
"settings.horizon.footer" = "Outside this window the menu bar shows only today's date. An event that is already running is always shown.";
"settings.sync.footer" = "macOS syncs Google and Exchange calendars on its own schedule. For new invitations to show up quickly, set Calendar › Settings › Accounts › Refresh Calendars to \"Every minute\".";
"settings.calendars.footer" = "Calendars come from the accounts in System Settings › Internet Accounts. For each one, choose where it appears: the panel list, the menu bar, notifications and the full-screen alert. Right-click a calendar to hide it from Calenbar altogether. Adding or deleting calendars happens in the Calendar app.";
"settings.calendars.noAccount" = "No calendar account on this Mac yet. Add your Google, Exchange or iCloud account and turn on Calendars; it shows up here within a minute.";
"panel.accountHint" = "Calenbar shows the calendars the Mac's Calendar app knows. Add your Google, Exchange or iCloud account in System Settings › Internet Accounts and turn on Calendars.";
"install.moveExplanation" = "Calenbar is running from a disk image or a temporary location. Moving it to the Applications folder lets it start at login and update itself.";
